            </property>
            <property name="styleSheet">
             <string notr="true">/* 1. Дефолтное состояние */
QLineEdit {
    background-color: #ffffff;
    color: #000000;
    border: 1px solid #000000;
    border-radius: 4px;
    padding: 2px 6px;                   
}

/* 2. Наведение (Hover) */
QLineEdit:hover {
    border: 1px solid #a6d8fc;
}

/* 3. Фокус (Focus) */
QLineEdit:focus {
    border: 1px solid #3498db;
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #ffffff, stop: 1 #e6f2ff
    );
}

/* 4. НОВОЕ: Состояние ошибки (активируется из кода) */
QLineEdit[hasError=&quot;true&quot;] {
    border: 1px solid #e74c3c;          /* Красная рамка */
    
    /* Плавный переход: сверху белый (#ffffff), снизу нежно-розовый/красный (#fdf2f2) */
    background-color: qlineargradient(
        x1: 0, y1: 0, 
        x2: 0, y2: 1,
        stop: 0 #ffffff, 
        stop: 1 #fdf2f2
    );
}
</string>
            </property>
           </widget>
          </item>
          <item row="4" column="0" colspan="2">
           <widget class="QPushButton" name="pb_ConfAuth">
            <property name="maximumSize">
             <size>
              <width>16777215</width>
              <height>20</height>
             </size>
            </property>
            <property name="styleSheet">
             <string notr="true">/* 1. Дефолтное состояние кнопки */
QPushButton {
    background-color: #f2f2f2;          /* Мягкий серый фон */
    color: #000000;                     /* Черный текст */
    border: 1px solid #bfbfbf;          /* Неяркая серая рамка */
    border-radius: 4px;                 /* Одинаковое скругление с QLineEdit */
    padding: 4px 12px;                  
}

/* 2. Наведение (Hover) */
QPushButton:hover {
    background-color: #ffe6cc;          /* Мягкий пастельный оранжевый */
    border: 1px solid #ff9933;          /* Мягкий оранжевый бортик */
    color: #000000;                     /* Текст остается черным */
}

/* 3. Нажатие (Pressed) */
QPushButton:pressed {
    /* Градиент «вдавливания» из оттенков мягкого оранжевого */
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #ffa64d, stop: 1 #ffe6cc
    );
    border: 1px solid #e67300;          /* Чуть более темный оранжевый бортик */
    padding-top: 5px;                   /* Небольшой сдвиг текста для эффекта клика */
    padding-bottom: 3px;
}

/* 4. Отключенное состояние (Disabled) */
QPushButton:disabled {
    background-color: #f9f9f9;          /* Совсем блеклый серый */
    color: #aaaaaa;                     /* Серый текст */
    border: 1px solid #dddddd;          
}
</string>
